-- ==========================================
-- HỆ THỐNG BYPASS ANTI-CHEAT (Bật/Tắt linh hoạt & Thông báo)
-- ==========================================
local bypassActive = false

local function RunBypassAC()
    bypassActive = not bypassActive
    
    if bypassActive then
        task.spawn(function()
            local Players = game:GetService("Players")
            local player = Players.LocalPlayer
            local isBypassed = false
            local attempts = 0
            
            print("[CPZ Anti-Cheat] Bắt đầu quy trình Bypass AC...")
            
            while bypassActive and not isBypassed and attempts < 10 do
                attempts = attempts + 1
                local character = player.Character or player.CharacterAdded:Wait()
                local hrp = character:WaitForChild("HumanoidRootPart")
                local humanoid = character:WaitForChild("Humanoid")
                
                -- Dịch chuyển tạm ra ngoài map để tránh va chạm ban đầu
                pcall(function()
                    hrp.CFrame = CFrame.new(0, 999999, 0)
                end)
                task.wait(0.4)
                
                -- Thử nghiệm Hook Metatable chặn Remote báo cáo
                local success = pcall(function()
                    local mt = getrawmetatable(game)
                    local old = mt.__namecall
                    setreadonly(mt, false)
                    
                    mt.__namecall = newcclosure(function(self, ...)
                        local method = getnamecallmethod()
                        if method == "FireServer" then
                            local name = tostring(self):lower()
                            if name:find("anticheat") or name:find("check") or name:find("teleport") or name:find("speed") then
                                return
                            end
                        end
                        return old(self, ...)
                    end)
                    setreadonly(mt, true)
                end)
                
                if success then
                    isBypassed = true
                    bypassActive = false -- Dừng vòng lặp vì đã thành công
                    pcall(function()
                        hrp.CFrame = CFrame.new(0, 50, 0) -- Trả về vị trí an toàn trên map
                    end)
                    
                    -- Thông báo thành công trực tiếp lên màn hình game
                    pcall(function()
                        local CoreGui = game:GetService("CoreGui")
                        if CoreGui:FindFirstChild("BypassNotice") then CoreGui.BypassNotice:Destroy() end
                        
                        local ScreenGui = Instance.new("ScreenGui")
                        ScreenGui.Name = "BypassNotice"
                        ScreenGui.Parent = CoreGui
                        
                        local TextLabel = Instance.new("TextLabel")
                        TextLabel.Parent = ScreenGui
                        TextLabel.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
                        TextLabel.BackgroundTransparency = 0.2
                        TextLabel.Position = UDim2.new(0.5, -175, 0, 20)
                        TextLabel.Size = UDim2.new(0, 350, 0, 40)
                        TextLabel.Font = Enum.Font.GothamBold
                        TextLabel.Text = "🚀 Bypassed Successfully! AC đã bị vô hiệu hóa."
                        TextLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
                        TextLabel.TextSize = 13
                        
                        local Corner = Instance.new("UICorner")
                        Corner.CornerRadius = UDim.new(0, 6)
                        Corner.Parent = TextLabel
                        
                        task.delay(5, function() if ScreenGui then ScreenGui:Destroy() end end)
                    end)
                    print("[CPZ Anti-Cheat] 🚀 Bypassed Successfully!")
                else
                    -- Chưa được thì ép nhân vật chết để respawn thử lại
                    pcall(function()
                        humanoid.Health = 0
                    end)
                    player.CharacterAdded:Wait()
                    task.wait(1.5)
                end
            end
            
            if not isBypassed and bypassActive then
                bypassActive = false
                print("[CPZ Anti-Cheat] ⚠️ Đã dừng hoặc quá số lần thử!")
            end
        end)
        print("[CPZ Anti-Cheat] Đã bật chế độ tự động Bypass...")
    else
        print("[CPZ Anti-Cheat] Đã dừng quá trình Bypass theo yêu cầu!")
    end
end

-- Tải Menu gốc CPZ của cậu
local CPZMenu = loadstring(game:HttpGet("https://raw.githubusercontent.com/talaben0307-jpg/cpzmenu/refs/heads/main/menu"))()

-- Tạo Window Cyberpunk
local Window = CPZMenu:CreateWindow({
    Title = "Gojo & Bypass Hub",
    SubTitle = "⚡ CPZ Edition | by Phong"
})

-- Khởi tạo Tab
local Tabs = {
    Gojo = Window:AddTab({ Title = "Gojo Farm & AC" })
}

Tabs.Gojo:AddSection("Gojo 0.2s Farm System")

local gojoFarmActive = false

Tabs.Gojo:AddButton({
    Title = "⚡ Bật / Tắt Gojo 0.2s Farm (Teleport Dưới Chân)",
    Callback = function()
        gojoFarmActive = not gojoFarmActive
        if gojoFarmActive then
            task.spawn(function()
                local Players = game:GetService("Players")
                local localPlayer = Players.LocalPlayer
                
                while gojoFarmActive do
                    local character = localPlayer.Character
                    if character and character:FindFirstChild("HumanoidRootPart") then
                        local hrp = character.HumanoidRootPart
                        
                        for _, targetPlayer in ipairs(Players:GetPlayers()) do
                            if not gojoFarmActive then break end
                            
                            if targetPlayer ~= localPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                local targetHRP = targetPlayer.Character.HumanoidRootPart
                                local targetHumanoid = targetPlayer.Character:FindFirstChild("Humanoid")
                                
                                if targetHumanoid and targetHumanoid.Health > 0 then
                                    pcall(function()
                                        hrp.CFrame = targetHRP.CFrame + Vector3.new(0, -3, 0)
                                    end)
                                    task.wait(0.2)
                                end
                            end
                        end
                    end
                    task.wait(0.1)
                end
            end)
        end
    end
})

Tabs.Gojo:AddSection("Anti-Cheat Controls")

Tabs.Gojo:AddButton({
    Title = "🛡️ Bật / Tắt AC Bypass Loop",
    Callback = function()
        RunBypassAC()
    end
})

-- Mặc định chọn tab đầu tiên
Window:SelectTab(1)
