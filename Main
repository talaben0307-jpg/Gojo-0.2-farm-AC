-- ==========================================
-- 1. BYPASS ANTI-CHEAT LOOP SYSTEM (Tự động thử nghiệm đến khi thành công)
-- ==========================================
local function RunBypassAC()
    task.spawn(function()
        local Players = game:GetService("Players")
        local player = Players.LocalPlayer
        local isBypassed = false
        local attempts = 0
        
        print("[CPZ Anti-Cheat] Bắt đầu quy trình Bypass AC...")
        
        while not isBypassed and attempts < 5 do
            attempts = attempts + 1
            local character = player.Character or player.CharacterAdded:Wait()
            local hrp = character:WaitForChild("HumanoidRootPart")
            local humanoid = character:WaitForChild("Humanoid")
            
            -- Dịch chuyển tạm ra ngoài map để tránh va chạm ban đầu
            pcall(function()
                hrp.CFrame = CFrame.new(0, 999999, 0)
            end)
            task.wait(0.4)
            
            -- Thử nghiệm Hook Metatable chặn Remote báo cáo vị trí/tốc độ
            local success = pcall(function()
                local mt = getrawmetatable(game)
                local old = mt.__namecall
                setreadonly(mt, false)
                
                mt.__namecall = newcclosure(function(self, ...)
                    local method = getnamecallmethod()
                    if method == "FireServer" then
                        local name = tostring(self):lower()
                        if name:find("anticheat") or name:find("check") or name:find("teleport") or name:find("speed") then
                            return -- Chặn gói tin phát hiện
                        end
                    end
                    return old(self, ...)
                end)
                setreadonly(mt, true)
            end)
            
            if success then
                isBypassed = true
                pcall(function()
                    hrp.CFrame = CFrame.new(0, 50, 0) -- Trả về vị trí an toàn
                end)
                print("[CPZ Anti-Cheat] 🚀 Bypassed Successfully! AC đã bị vô hiệu hóa.")
            else
                -- Nếu chưa thành công, ép nhân vật chết để vòng lặp làm mới (Respawn)
                pcall(function()
                    humanoid.Health = 0
                end)
                player.CharacterAdded:Wait()
                task.wait(1.5)
            end
        end
        
        if not isBypassed then
            print("[CPZ Anti-Cheat] ⚠️ Đã quá số lần thử, vui lòng kiểm tra lại Executor!")
        end
    end)
end

-- Tải Menu gốc CPZ của cậu
local CPZMenu = loadstring(game:HttpGet("https://raw.githubusercontent.com/talaben0307-jpg/cpzmenu/refs/heads/main/menu"))()

-- Tạo Window Cyberpunk
local Window = CPZMenu:CreateWindow({
    Title = "Steal An Egg & Gojo Ultimate Hub",
    SubTitle = "⚡ CPZ Edition | by Phong"
})

-- Hàm dịch chuyển nhặt trứng mượt mà
local function AutoFarmTarget(targetName, isSpecial)
    pcall(function()
        local folder = workspace:FindFirstChild("Eggs") or workspace:FindFirstChild("Biomes") or workspace
        for _, obj in pairs(folder:GetDescendants()) do
            if obj:IsA("Model") and (obj.Name:lower():find(targetName:lower()) or (isSpecial and obj:FindFirstChild("Special"))) then
                if obj.PrimaryPart and game.Players.LocalPlayer.Character then
                    local hrp = game.Players.LocalPlayer.Character.HumanoidRootPart
                    local tweenService = game:GetService("TweenService")
                    local info = TweenInfo.new(0.15, Enum.EasingStyle.Linear)
                    local tween = tweenService:Create(hrp, info, {CFrame = obj.PrimaryPart.CFrame})
                    tween:Play()
                    task.wait(0.2)
                end
            end
        end
    end)
end

-- ==========================================
-- KHỞI TẠO CÁC TAB
-- ==========================================
local Tabs = {
    Gojo = Window:AddTab({ Title = "Gojo 0.2s Farm" }),
    Biomes1 = Window:AddTab({ Title = "Biomes [1-5]" }),
    Biomes2 = Window:AddTab({ Title = "Biomes [6-10]" }),
    Biomes3 = Window:AddTab({ Title = "Biomes [11-13]" }),
    Special = Window:AddTab({ Title = "Special & All" }),
    Misc = Window:AddTab({ Title = "Misc & ESP" })
}

-- ==========================================
-- 1. TAB: GOJO 0.2S FARM (Teleport sát dưới chân + Theo dõi Respawn)
-- ==========================================
Tabs.Gojo:AddSection("Infinite Gojo 0.2s Farm")

local gojoFarmActive = false

Tabs.Gojo:AddButton({
    Title = "⚡ Bật / Tắt Gojo 0.2s Farm (Teleport Dưới Chân)",
    Callback = function()
        gojoFarmActive = not gojoFarmActive
        if gojoFarmActive then
            task.spawn(function()
                local Players = game:GetService("Players")
                local localPlayer = Players.LocalPlayer
                
                while gojoFarmActive do
                    local character = localPlayer.Character
                    if character and character:FindFirstChild("HumanoidRootPart") then
                        local hrp = character.HumanoidRootPart
                        
                        for _, targetPlayer in ipairs(Players:GetPlayers()) do
                            if not gojoFarmActive then break end
                            
                            if targetPlayer ~= localPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                local targetHRP = targetPlayer.Character.HumanoidRootPart
                                local targetHumanoid = targetPlayer.Character:FindFirstChild("Humanoid")
                                
                                if targetHumanoid and targetHumanoid.Health > 0 then
                                    pcall(function()
                                        -- Teleport ngay lập tức sát dưới chân mục tiêu
                                        hrp.CFrame = targetHRP.CFrame + Vector3.new(0, -3, 0)
                                    end)
                                    task.wait(0.2)
                                end
                            end
                        end
                    end
                    task.wait(0.1)
                end
            end)
            print("[CPZ Hub] Đã bật Gojo 0.2s Farm dưới chân!")
        else
            print("[CPZ Hub] Đã tắt Gojo 0.2s Farm!")
        end
    end
})

Tabs.Gojo:AddButton({
    Title = "🛡️ Chạy Bypass AC Loop (Bắt buộc trước khi Farm)",
    Callback = function()
        RunBypassAC()
    end
})

