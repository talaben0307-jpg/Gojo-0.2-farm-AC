-- ==========================================
-- HỆ THỐNG BYPASS ANTI-CHEAT JJS (VOID TRICK & HOOK)
-- ==========================================
local bypassActive = false

local function RunBypassAC()
    bypassActive = not bypassActive
    
    if bypassActive then
        task.spawn(function()
            local Players = game:GetService("Players")
            local player = Players.LocalPlayer
            local isBypassed = false
            local attempts = 0
            
            print("[JJS Anti-Cheat] Bắt đầu quy trình Bypass Void & Hook...")
            
            while bypassActive and not isBypassed and attempts < 10 do
                attempts = attempts + 1
                local character = player.Character or player.CharacterAdded:Wait()
                local hrp = character:WaitForChild("HumanoidRootPart")
                local currentCFrame = hrp.CFrame
                
                -- Bước 1: Dịch chuyển ra vùng Void (vùng ngoài biên bản đồ / vùng chết) để đánh lừa server
                pcall(function()
                    hrp.CFrame = CFrame.new(0, -500, 0)
                end)
                task.wait(0.4)
                
                -- Bước 2: Kéo tạm về vị trí cũ để thực hiện hook an toàn
                pcall(function()
                    hrp.CFrame = currentCFrame
                end)
                task.wait(0.2)
                
                -- Bước 3: Hook Metatable chuyên sâu chặn Remote báo cáo của JJS
                local success = pcall(function()
                    local mt = getrawmetatable(game)
                    local old = mt.__namecall
                    setreadonly(mt, false)
                    
                    mt.__namecall = newcclosure(function(self, ...)
                        local method = getnamecallmethod()
                        if method == "FireServer" then
                            local name = tostring(self):lower()
                            if name:find("anticheat") or name:find("check") or name:find("teleport") or name:find("speed") or name:find("combat") then
                                return 
                            end
                        end
                        return old(self, ...)
                    end)
                    setreadonly(mt, true)
                end)
                
                if success then
                    isBypassed = true
                    bypassActive = false 
                    
                    -- Thông báo thành công trực tiếp trên màn hình game
                    pcall(function()
                        local CoreGui = game:GetService("CoreGui")
                        if CoreGui:FindFirstChild("BypassNotice") then CoreGui.BypassNotice:Destroy() end
                        
                        local ScreenGui = Instance.new("ScreenGui")
                        ScreenGui.Name = "BypassNotice"
                        ScreenGui.Parent = CoreGui
                        
                        local TextLabel = Instance.new("TextLabel")
                        TextLabel.Parent = ScreenGui
                        TextLabel.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
                        TextLabel.BackgroundTransparency = 0.2
                        TextLabel.Position = UDim2.new(0.5, -175, 0, 20)
                        TextLabel.Size = UDim2.new(0, 350, 0, 40)
                        TextLabel.Font = Enum.Font.GothamBold
                        TextLabel.Text = "🚀 JJS AC Bypassed Successfully!"
                        TextLabel.TextColor3 = Color3.fromRGB(0, 255, 128)
                        TextLabel.TextSize = 13
                        
                        local Corner = Instance.new("UICorner")
                        Corner.CornerRadius = UDim.new(0, 6)
                        Corner.Parent = TextLabel
                        
                        task.delay(5, function() if ScreenGui then ScreenGui:Destroy() end end)
                    end)
                    print("[JJS Anti-Cheat] 🚀 Bypassed Successfully!")
                else
                    -- Bước 4: Nếu chưa thành công, ép nhân vật chết (BreakJoints) để Respawn làm mới vòng đời
                    pcall(function()
                        if player.Character then
                            player.Character:BreakJoints()
                        end
                    end)
                    player.CharacterAdded:Wait()
                    task.wait(1.5)
                end
            end
            
            if not isBypassed and bypassActive then
                bypassActive = false
                print("[JJS Anti-Cheat] ⚠️ Đã dừng hoặc quá số lần thử!")
            end
        end)
        print("[JJS Anti-Cheat] Đang chạy vòng lặp Bypass Void & Hook...")
    else
        print("[JJS Anti-Cheat] Đã tắt quá trình Bypass!")
    end
end

-- Tải Menu gốc CPZ của cậu
local CPZMenu = loadstring(game:HttpGet("https://raw.githubusercontent.com/talaben0307-jpg/cpzmenu/refs/heads/main/menu"))()

-- Tạo Window Cyberpunk
local Window = CPZMenu:CreateWindow({
    Title = "Gojo & JJS Bypass Hub",
    SubTitle = "⚡ CPZ Edition | by Phong"
})

-- Khởi tạo Tab
local Tabs = {
    Gojo = Window:AddTab({ Title = "Gojo Farm & AC" })
}

-- ==========================================
-- TÍNH NĂNG GOJO 0.2S FARM (ĐÃ ĐƯỢC THÊM LẠI)
-- ==========================================
Tabs.Gojo:AddSection("Gojo 0.2s Farm System")

local gojoFarmActive = false

Tabs.Gojo:AddButton({
    Title = "⚡ Bật / Tắt Gojo 0.2s Farm (Teleport Dưới Chân)",
    Callback = function()
        gojoFarmActive = not gojoFarmActive
        if gojoFarmActive then
            task.spawn(function()
                local Players = game:GetService("Players")
                local localPlayer = Players.LocalPlayer
                
                while gojoFarmActive do
                    local character = localPlayer.Character
                    if character and character:FindFirstChild("HumanoidRootPart") then
                        local hrp = character.HumanoidRootPart
                        
                        -- Duyệt qua toàn bộ người chơi trong server
                        for _, targetPlayer in ipairs(Players:GetPlayers()) do
                            if not gojoFarmActive then break end
                            
                            if targetPlayer ~= localPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                local targetHRP = targetPlayer.Character.HumanoidRootPart
                                local targetHumanoid = targetPlayer.Character:FindFirstChild("Humanoid")
                                
                                if targetHumanoid and targetHumanoid.Health > 0 then
                                    pcall(function()
                                        -- Teleport bám sát ngay dưới chân mục tiêu mỗi 0.2s
                                        hrp.CFrame = targetHRP.CFrame + Vector3.new(0, -3, 0)
                                    end)
                                    task.wait(0.2)
                                end
                            end
                        end
                    end
                    task.wait(0.1)
                end
            end)
            print("[CPZ Hub] Đã bật Gojo 0.2s Farm dưới chân!")
        else
            print("[CPZ Hub] Đã tắt Gojo 0.2s Farm!")
        end
    end
})

-- ==========================================
-- TÍNH NĂNG BYPASS AC
-- ==========================================
Tabs.Gojo:AddSection("JJS Anti-Cheat Controls")

Tabs.Gojo:AddButton({
    Title = "🛡️ Bật / Tắt JJS AC Bypass (Void & Hook Loop)",
    Callback = function()
        RunBypassAC()
    end
})

Window:SelectTab(1)
